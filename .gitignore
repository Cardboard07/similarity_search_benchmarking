# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.ipynb_checkpoints/
.pytest_cache/

# Virtual environments
.env
.venv
env/
venv/

# Large datasets, binary structures, and model weights
*.h5
*.hdf5
*.bin
*.pkl
*.npy
*.npz

# Ignore contents of fingerprint_dataset
fingerprint_dataset/

# Large dataset shards and signature outputs
dataset/*.h5
dataset/*.bin
dataset/signatures_shards/
!dataset/manifest.json

# Ignore contents of data_structure but keep directory
**/data_structure/*
!**/data_structure/.gitkeep
